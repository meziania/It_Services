# --- Database ---
DATABASE_URL="postgresql://sis:sis@127.0.0.1:5434/serviceit_scanner?schema=public"
# Same as DATABASE_URL locally. On Neon: direct connection (no pooler) for migrations.
DIRECT_DATABASE_URL="postgresql://sis:sis@127.0.0.1:5434/serviceit_scanner?schema=public"

# --- Cache / Queue ---
REDIS_URL="redis://127.0.0.1:6381"
RABBITMQ_URL="amqp://sis:sis@127.0.0.1:5673"

# --- API ---
# 3001 collides with another local project's API on this machine, so
# ServiceIt-scanner's API runs on 3011 instead (see also apps/web/.env.local).
API_PORT=3011
API_CORS_ORIGIN="http://localhost:3020"

# --- Auth (Docs2/12 Sprint 2) ---
# Dev-only secret. Generate a real random value before deploying anywhere.
JWT_SECRET="dev-only-insecure-secret-change-me"

# --- Web ---
NEXT_PUBLIC_API_URL="http://localhost:3011"

# --- Outreach (later sprints) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
